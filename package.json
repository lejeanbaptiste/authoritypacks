{
  "name": "authority-extraction",
  "version": "0.1.0",
  "private": true,
  "description": "Offline pipelines to compile authority sources into LJB tag-string packs",
  "type": "module",
  "scripts": {
    "validate": "node wikidata/validate.mjs",
    "wikidata:validate": "node wikidata/validate.mjs",
    "wikidata:sparql": "node wikidata/run-sparql.mjs",
    "wikidata:build-closure": "node wikidata/buildKindClosure.mjs",
    "wikidata:extract": "node wikidata/extract.mjs",
    "wikidata:compile": "node wikidata/compile.mjs",
    "wikidata:compile-all": "node wikidata/compile-all.mjs",
    "wikidata:compile-pre-ming": "node wikidata/compile.mjs --pack pre-ming --raw packs/wikidata/raw-zh-hant-pre-ming/persons.raw.ndjson --out packs/wikidata/person-zh-hant-pre-ming",
    "wikidata:extract-pre-ming": "node wikidata/extract.mjs --membership pre-ming",
    "wikidata:extract-ja": "node wikidata/extract.mjs --membership country --country japan --language ja --out packs/wikidata/raw-ja-japan",
    "wikidata:extract-bo": "node wikidata/extract.mjs --kinds person,place,org --membership label-only --language bo --out packs/wikidata/raw-bo",
    "wikidata:compile-bo": "node wikidata/compile-bo-all.mjs",
    "wikidata:extract-places-zh": "node wikidata/extract.mjs --kinds place --membership label-only --language zh-hant --out packs/wikidata/raw-zh-hant-places",
    "wikidata:compile-places-zh": "node wikidata/compileKind.mjs --raw packs/wikidata/raw-zh-hant-places/places.raw.ndjson --kind place --language zh-hant --out packs/wikidata/place-zh-hant",
    "wikidata:extract-places-ja": "node wikidata/extract.mjs --kinds place --membership country --country japan --language ja --out packs/wikidata/raw-ja-places",
    "wikidata:compile-places-ja": "node wikidata/compileKind.mjs --raw packs/wikidata/raw-ja-places/places.raw.ndjson --kind place --language ja --country japan --out packs/wikidata/place-ja",
    "refilter:ja-packs": "node scripts/refilterJaPacks.mjs",
    "wikidata:viaf-concordance": "node wikidata/buildViafConcordance.mjs --scan-packs packs/wikidata --out packs/wikidata/viaf-wikidata-concordance.ndjson",
    "wikidata:extract-crosswalk": "node wikidata/extractCrosswalkConcordance.mjs --dump /home/d/Data/latest-all.json.bz2 --out-dir packs/wikidata --keys viaf,cbdb,ndl,dila,bdrc",
    "wikidata:attach-crosswalk": "node wikidata/attachAuthorityCrosswalk.mjs --wikidata-root packs/wikidata --also-pairs",
    "wikidata:extract-works-zh": "node wikidata/extract.mjs --kinds work --membership label-only --language zh-hant",
    "wikidata:extract-zh-ja-orgs-works": "node wikidata/extract.mjs --kinds org,work --membership label-only --languages zh-hant,ja --out packs/wikidata/raw-zh-hant-ja-org-work",
    "wikidata:compile-zh-ja-orgs-works": "node wikidata/compile-zh-ja-orgs-works.mjs",
    "wikidata:export-ime": "node wikidata/exportIme.mjs",
    "wikidata:report": "node wikidata/report.mjs",
    "ndl:parse-works": "node ndl/parseWorks.mjs",
    "ndl:compile-works": "node ndl/compileWorks.mjs",
    "ndl:sparql": "node ndl/run-sparql.mjs",
    "ndl:compile-persons": "node ndl/compilePersons.mjs",
    "ndl:export-ime": "node ndl/exportIme.mjs",
    "ndl:compile-places": "node ndl/compilePlaces.mjs",
    "ndl:compile-orgs": "node ndl/compileOrgs.mjs",
    "compile:dila": "node dila/compile.mjs",
    "compile:cbdb": "node cbdb/compile.mjs",
    "compile:norbert": "node norbert/compile.mjs",
    "compile:huckbot5000": "node huckbot5000/compile.mjs",
    "packs:dedupe-zi": "node scripts/dedupeFamilyPrefixedNames.mjs",
    "norbert:sqlite": "node norbert/sqlToSqlite.mjs",
    "cbdb:strip-reference": "node cbdb/stripReferenceDb.mjs",
    "build:reference": "node scripts/build-reference-bundle.mjs",
    "audit:origins": "node scripts/audit-origins.mjs",
    "audit:noble-titles": "node scripts/audit-noble-titles.mjs",
    "compile:noble-title-include": "node scripts/compile-noble-title-include.mjs",
    "concordance:offices": "node norbert/officeConcordance.mjs",
    "concordance:persons": "node norbert/concordance.mjs --norbert packs/norbert --cbdb packs/cbdb --dila packs/dila --wikidata packs/wikidata --out packs/norbert/norbert-concordance.ndjson --review-csv reports/norbert-person-concordance-review.csv",
    "concordance:merge-review": "node norbert/mergeReviewCsv.mjs",
    "concordance:integrate": "node norbert/integrateConcordance.mjs",
    "concordance:purge-orders": "node scripts/build-purge-orders.mjs",
    "wikidata:viaf-filter": "node wikidata/filterViafConcordance.mjs --concordance packs/wikidata/viaf-wikidata-concordance.ndjson --scan-packs packs/wikidata --out packs/wikidata/viaf-wikidata-concordance.filtered.ndjson --chunk-dir packs/wikidata/viaf-wikidata-concordance",
    "compile:chgis": "node chgis/compile.mjs",
    "extract:chgis-places": "node chgis/extractPlacesTsv.mjs",
    "extract:dila-places": "node dila/extractPlacesTsv.mjs",
    "crosswalk:chgis-dila": "node crosswalks/buildChgisDila.cli.mjs",
    "report:cbdb": "node cbdb/report.mjs",
    "create:cbdb-fixture": "node scripts/create-cbdb-fixture.mjs",
    "fetch:upstream": "node scripts/fetch-upstream.mjs",
    "build:packs": "node scripts/build-pack-bundle.mjs",
    "build:packs:full": "node scripts/fetch-upstream.mjs && node scripts/build-pack-bundle.mjs",
    "authoritypacks:release": "node scripts/fetch-upstream.mjs && node scripts/build-authority-pack-release.mjs",
    "map-tiles:release": "node scripts/build-map-tile-release.mjs",
    "test": "node --test '**/*.test.mjs'"
  },
  "license": "GPL-2.0",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fast-xml-parser": "^5.9.3",
    "proj4": "^2.20.9",
    "sax": "^1.6.0",
    "shapefile": "^0.6.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
