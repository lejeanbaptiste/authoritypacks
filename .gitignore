node_modules/
.upstream/
# Downloaded authority sources live in .upstream/; only pins.json is tracked here
upstream/*
!upstream/pins.json
dist/
release/
reports/*.ndjson
reports/*.csv
reports/*.tsv
# Checked-in CHGIS<->DILA crosswalk (built locally, shipped with the release)
!reports/chgis-dila-crosswalk.tsv
# Checked-in Norbert person concordance review (Tier 2 link rows; required by build:packs)
!reports/norbert-person-concordance-review.csv

# Ignore compiled packs (can be regenerated from sources)
packs/cbdb/
packs/dila/
packs/ndl/persons-ja/
packs/ndl/works-ja/
packs/ndl/places-ja/
packs/ndl/orgs-ja/
packs/ndl/orgs-smoke-ja/
packs/ndl/ime.csv
packs/chgis-test/
packs/norbert/
# Huckbot / MaxiRicci: track shippable outputs only (like Wikidata); keep staging + insiders local.
packs/huckbot5000/candidates*.ndjson
packs/huckbot5000/lexicon.ndjson
packs/huckbot5000/translations-manifest.json
packs/huckbot5000-insiders/
packs/maxiricci7000/batch-*.ndjson
packs/maxiricci7000/candidates-*.ndjson
packs/maxiricci7000/french-lexicon.ndjson
packs/maxiricci7000/rotours-seeds.ndjson
packs/maxiricci7000/translations-manifest.json
huckbot5000/insiders-include.ndjson

# Ignore Wikidata raw extract directories (intermediate files)
packs/wikidata/raw-*/
packs/wikidata/raw-zh-hant-*/

# Keep test packs for regression tests
!packs/test-dila/
!packs/test-dila/**
!packs/test-ndl/
!packs/test-ndl/**

# Keep raw NDL files, Wikidata packs, and the pre-compiled CHGIS pack (needed for CI)
!packs/ndl/raw/
!packs/wikidata/
!packs/chgis/
!packs/chgis/**

*.bz2
*.json.gz
.DS_Store

# Norbert
norbert_secret/
skunkworks/

# BDRC — raw/cleaned CSVs and compiled packs stay local-only
bdrc/*
!bdrc/fixtures/
!bdrc/fixtures/**
!bdrc/compile.mjs
!bdrc/compileRecords.mjs
!bdrc/compile.test.mjs
!bdrc/README.md
packs/bdrc/